// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores game reviews.
// This model is managed by Ivan.
model Review {
  id       Int    @id @default(autoincrement())
  game     String
  username String
  rating   Int
  comment  String
}

// Stores game information.
// This model is managed by Philip.
model Game {
  id          Int    @id @default(autoincrement())
  title       String
  genre       String
  description String

  // Relationship to the Game Library
  libraryEntry LibraryEntry?
}

// Stores games added to the Game Library.
// This model is managed by Abhinaya.
model LibraryEntry {
  id      Int    @id @default(autoincrement())
  gameId  Int    @unique
  status  String @default("Not Installed")

  // Foreign key relationship to Game
  game Game @relation(fields: [gameId], references: [id])
}
